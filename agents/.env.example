# === Blockchain ===
RPC_URL=https://rpc-zk.tanenbaum.io
RPC_FALLBACK=
CHAIN_ID=57057
# OJO: estos nombres deben coincidir con agents/app/settings.py (REGISTRY_ADDRESS / VOTE_ADDRESS).
# Para demo local (Anvil) usar las direcciones de blockchain/deployments/localhost.json.
REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
VOTE_ADDRESS=0x0000000000000000000000000000000000000000

# === Database (Postgres) — REQUERIDO por settings.py ===
# Local (Docker infra): postgresql://postgres:postgres@localhost:55432/civicsys
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/civicsys

# PUBLIC_SALT — secreto compartido entre componentes.
# GENERAR con `openssl rand -hex 32` y persistir en `.env` (gitignored).
# Ver docs/security/runbook-rotacion-salt.md y ADR-001.
PUBLIC_SALT=<GENERATE_WITH_OPENSSL_RAND_HEX_32>

# === LLM ===
# Gemini primario (Sprint 02b). Al menos uno seteado para análisis real;
# sin ninguno -> Hermes responde con análisis simulado (provider=simulado).
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL_GEMINI=gemini-3.5-flash

# === Integridad de reportes (HMAC) ===
# Clave para HMAC-SHA256 de reportes persistidos. GENERAR con `openssl rand -hex 32`.
# Ver docs/plans/executed/arquitectura/ADR-002-audit-log-l1.md.
MEMORY_INTEGRITY_KEY=<GENERATE_WITH_OPENSSL_RAND_HEX_32>

# === API ===
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# === MCP ===
# Token Bearer para autenticar clientes MCP. GENERAR con `openssl rand -hex 32`.
# Sin token o token <32 chars -> el server NO arranca. Ver docs/security/mcp-policy.md.
MCP_AUTH_TOKEN=<GENERATE_WITH_OPENSSL_RAND_HEX_32>
MCP_TRANSPORT=stdio
MCP_PORT=8765

# === Hermes ===
HERMES_MEMORY_DIR=./hermes/memory
HERMES_LOG_LEVEL=INFO

# === Bots de Discord (entrega del hackathon — DOS bots, dos apps/tokens) ===
# Developer Portal → cada app → Bot → Reset Token. Guía: docs/discord-bot-setup.md
DISCORD_CIVICSYS_TOKEN=
DISCORD_TOXICA_TOKEN=
HERMES_URL=http://localhost:8000
APP_URL=http://localhost:3000
DISCORD_GUILD_ID=   # opcional: ID del servidor para sync instantáneo de slash commands

# ─────────────────────────────────────────────────────────────────────────
# NO custodial signer en Sprint 1/2
# ─────────────────────────────────────────────────────────────────────────
# SIGNER_PRIVATE_KEY ha sido eliminado deliberadamente. Hermes no firma
# transacciones — el ciudadano firma desde su wallet (MetaMask) y el backend
# Node solo lee on-chain. Ver:
#   - docs/security/threat-model.md (vector S7 dormido)
#   - docs/plans/executed/arquitectura/ADR-002-audit-log-l1.md
#
# LLM_BASE_URL ha sido eliminado: el LLMClient usa endpoints hardcoded
# (api.anthropic.com, openrouter.ai). Re-introducir requiere ADR especifico.
